# Server Configuration
PORT=8081

# ===========================================
# TTS Configuration
# ===========================================
# Options: 'aws', 'whisper', 'dummy'
TTS_PROVIDER=dummy

# AWS TTS Configuration (when TTS_PROVIDER=aws)
AWS_TTS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_TTS_VOICE=Joanna
# Options: pcm, mp3, ogg_vorbis
AWS_TTS_OUTPUT_FORMAT=pcm
AWS_TTS_SAMPLE_RATE=8000
# Options: text, ssml
AWS_TTS_TEXT_TYPE=text

# Whisper TTS Configuration (when TTS_PROVIDER=whisper)
WHISPER_MODEL_PATH=/path/to/whisper/model
WHISPER_VOICE=alloy
WHISPER_SPEED=1.0
WHISPER_TEMPERATURE=0.7

# ===========================================
# Secret Service Configuration
# ===========================================
# Options: 'env', 'aws-secrets-manager', 'file', 'static'
SECRET_PROVIDER=env

# AWS Secrets Manager Configuration (when SECRET_PROVIDER=aws-secrets-manager)
AWS_SECRETS_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are reused from TTS config
AWS_SECRET_PREFIX=audiohook/

# File-based Secrets Configuration (when SECRET_PROVIDER=file)
SECRETS_FILE_PATH=./secrets.json

# Environment-based Secrets Configuration (when SECRET_PROVIDER=env)
# Pattern: API_KEY_<NAME> and SECRET_<NAME>
API_KEY_PROD=ApiKey1
SECRET_PROD=Secret1

API_KEY_DEV=DevApiKey
SECRET_DEV=DevSecret123

API_KEY_TEST=TestKey
SECRET_TEST=TestSecret456

# Default fallback secrets
DEFAULT_API_KEY=ApiKey1
DEFAULT_SECRET=Secret1

# ===========================================
# Additional Security Configuration
# ===========================================
# JWT Secret for additional authentication (optional)
JWT_SECRET=your_jwt_secret_here

# Rate limiting (requests per minute)
RATE_LIMIT=100

# Enable/disable request logging
ENABLE_REQUEST_LOGGING=true

# ===========================================
# ASR Configuration (for future enhancement)
# ===========================================
# ASR_PROVIDER=aws
# AWS_ASR_REGION=us-east-1
# AWS_ASR_LANGUAGE=en-US

# ===========================================
# Bot Service Configuration (for future enhancement)
# ===========================================
# BOT_PROVIDER=custom
# BOT_ENDPOINT=https://your-bot-api.com
# BOT_API_KEY=your_bot_api_key